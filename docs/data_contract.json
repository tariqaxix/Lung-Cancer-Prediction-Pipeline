{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LungCancerRiskPredictionContract",
  "version": "1.0.0",
  "description": "Input/output contract for the lung cancer risk prediction API",
  "input": {
    "type": "object",
    "required": ["age", "country", "gender", "smoker", "years_of_smoking", "cigarettes_per_day"],
    "properties": {
      "age":                {"type": "integer", "minimum": 0,  "maximum": 120},
      "country":            {"type": "string",  "minLength": 2},
      "gender":             {"type": "string",  "enum": ["Male", "Female"]},
      "smoker":             {"type": "string",  "enum": ["Yes", "No"]},
      "years_of_smoking":   {"type": "integer", "minimum": 0},
      "cigarettes_per_day": {"type": "integer", "minimum": 0}
    }
  },
  "output": {
    "type": "object",
    "properties": {
      "risk_score":     {"type": "number",  "minimum": 0.0, "maximum": 1.0},
      "risk_label":     {"type": "string",  "enum": ["Low", "Medium", "High"]},
      "model_version":  {"type": "string"}
    }
  }
}